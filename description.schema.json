{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:escape-director:custom-device-description:v1",
  "title": "Escape Director custom device description (contract v1)",
  "description": "Also enforced when the controller pairs: compact UTF-8 JSON is at most 16384 bytes; prop IDs are unique, and signal, command and state IDs are unique within their prop; enum values are unique and labels only name declared values; a number field's min is not greater than its max; completion names a signal and a command declared on the same prop.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "number",
      "const": 1
    },
    "firmwareVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "configuration": {
      "type": "string",
      "const": "firmware-owned"
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "transitions": {
          "type": "boolean"
        }
      },
      "required": [
        "transitions"
      ],
      "additionalProperties": false
    },
    "props": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "signals": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,39}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "commands": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,39}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "testable": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "testable"
              ],
              "additionalProperties": false
            }
          },
          "state": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "type": {
                      "type": "string",
                      "const": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "type": {
                      "type": "string",
                      "const": "number"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "type",
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "type": {
                      "type": "string",
                      "const": "enum"
                    },
                    "values": {
                      "minItems": 1,
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,39}$"
                      }
                    },
                    "labels": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,39}$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "type",
                    "values"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "completion": {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "command": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              }
            },
            "required": [
              "signal",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "signals",
          "commands",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "firmwareVersion",
    "name",
    "configuration",
    "diagnostics",
    "props"
  ],
  "additionalProperties": false
}
